{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AIDrawingModuleOptions": {
    "KernelName": "KernelOpenAi-gpt-5-mini",
    "SemanticKernelsSettings": {
      "ApiKeys": {
        "DevAzureOpenAiApiKey": "fake-api-key",
        "DevOpenAiApiKey": "fake-api-key"
      },
      "LogLevel": "Warning",
      "KernelSettings": [
        // AZURE OPEN AI : WHATCH OUT THSE SETTINGS USE DEPLOYMENTS present in a TOP CONSUL project. It's advisable to create a dedicated Azure Open AI instance
        // gpt5-mini (reasonining)
        {
          "Plugins": [ "AIDrawingModule.SKPlugins.SemanticKernelPlugins" ],
          "Name": "KernelAzureOpenAi-gpt-5-mini",
          "SystemMessageName": "system-message-1.md",
          "Temperature": 1, // only 1 allowed
          "OpenAISpecificSettings": {
            "ReasoningEffort": "low" // should move to minimum when supported by SK
          },
          "Model": {
            "Category": "AzureOpenAi",
            "DeploymentOrModelName": "gpt-5-mini",
            "Url": "https://dev-openai-topconsult-sw-oai.openai.azure.com",
            "ApiKeyName": "DevAzureOpenAiApiKey"
          }
        }
        // gpt4.1
        ,
        {
          "Plugins": [ "AIDrawingModule.SKPlugins.SemanticKernelPlugins" ],
          "Name": "KernelAzureOpenAi-gpt-4.1",
          "SystemMessageName": "system-message-1.md",
          "Temperature": 0,
          "Model": {
            "Category": "AzureOpenAi",
            "DeploymentOrModelName": "gpt-4.1",
            "Url": "https://dev-openai-topconsult-sw-oai.openai.azure.com",
            "ApiKeyName": "DevAzureOpenAiApiKey"
          }
        },

        // OPEN AI
        // gpt5-mini (reasonining)
        {
          "Plugins": [ "AIDrawingModule.SKPlugins.SemanticKernelPlugins" ],
          "Name": "KernelOpenAi-gpt-5-mini",
          "SystemMessageName": "system-message-1.md",
          "Temperature": 1, // only 1 allowed
          "OpenAISpecificSettings": {
            "ReasoningEffort": "low" // should move to minimum when supported by SK
          },
          "Model": {
            "RequiresUrl": false,
            "Category": "OpenAi",
            "DeploymentOrModelName": "gpt-5-mini",
            "Url": "",
            "ApiKeyName": "DevOpenAiApiKey"
          }
        }
        // gpt4.1
        ,
        {
          "Plugins": [ "AIDrawingModule.SKPlugins.SemanticKernelPlugins" ],
          "Name": "KernelOpenAi-gpt-4.1",
          "SystemMessageName": "system-message-1.md",
          "Temperature": 0,
          "Model": {
            "RequiresUrl": false,
            "Category": "OpenAi",
            "DeploymentOrModelName": "gpt-4.1",
            "Url": "",
            "ApiKeyName": "DevOpenAiApiKey"
          }
        }
      ]
    }
  }
}


